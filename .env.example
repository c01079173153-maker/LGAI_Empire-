# ============================================
# ⚠️ 절대 이 파일을 GitHub에 올리지 마세요! ⚠️
# ============================================

# Sepolia 테스트넷 RPC URL (Alchemy 또는 Infura에서 무료로 받을 수 있습니다)
# Alchemy: https://www.alchemy.com/ 에서 가입 후 Sepolia App 생성
# Infura: https://infura.io/ 에서 가입 후 API Key 생성
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# 메타마스크 개인키 (절대 공유 금지!)
# 메타마스크 > 계정 세부 정보 > 개인 키 내보내기
PRIVATE_KEY=여기에_메타마스크_개인키_입력

# (선택) Etherscan API Key - 컨트랙트 검증용
# https://etherscan.io/apis 에서 무료 발급
ETHERSCAN_API_KEY=

# 사령관님의 devWallet 주소 (세금 수령 지갑)
DEV_WALLET=여기에_devWallet_주소_입력
